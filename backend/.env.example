# StrokeSpeak Backend Configuration Template
# Copy to .env and replace placeholders with local credentials. Never commit .env.

DB_HOST=localhost
DB_PORT=3306
DB_NAME=strokespeak
DB_USER=root
DB_PASSWORD=YOUR_PASSWORD_HERE

# Unique random key used to sign 8-hour learner access tokens (minimum 32 characters).
# Generate locally with: python -c "import secrets; print(secrets.token_urlsafe(48))"
STROKESPEAK_AUTH_SECRET=REPLACE_WITH_A_PRIVATE_RANDOM_SECRET

# Optional comma-separated numeric account IDs that may edit shared curriculum data.
# Leave blank unless an administrator account has been deliberately chosen.
STROKESPEAK_ADMIN_USER_IDS=

# Speech transcription provider: local Faster-Whisper (default) or openai (requires a billed API key).
STROKESPEAK_TRANSCRIPTION_PROVIDER=local
STROKESPEAK_WHISPER_MODEL=base
OPENAI_API_KEY=

# Set to true only for explicit developer testing; keep false to enforce lesson/quiz prerequisites.
STROKESPEAK_DEVELOPER_BYPASS=false
